%\geometry{noheadfoot,top=30truemm,bottom=25truemm,hmargin=20truemm}
\setlength{\columnsep}{7mm}
\renewcommand\footnoterule{\rule{\linewidth}{0.6pt}}
\pagestyle{empty}
\newcommand{\AuthorFixed}{自動ソフトウェア工学研究室 博士前期課程2年生}
\newcommand{\setAuthorFixed}[1]{\renewcommand{\AuthorFixed}{#1}}

\def\title#1#2{%
\def\@titleJa{#1}%
\def\@titleEn{#2}%
}
\newcount\author@count
\advance\author@count\@ne
\def\author#1#2#3{%
  \advance\author@count\@ne
  \expandafter\def\csname authorAffiliate\the\author@count\endcsname{\AuthorFixed}%
  \expandafter\def\csname authorName\the\author@count\endcsname{#2}%
  \expandafter\def\csname authorEn\the\author@count\endcsname{}%
}
\def\@maketitle{%
\newpage
\vspace*{-15truemm}
\noindent\AcademicYear\hrulefill\par
\vspace*{10truemm}
\begin{center}
\setcounter{footnote}{-1}% no footnote symbol
{\fontsize{16truept}{0pt}\selectfont\@titleJa}\\
{\fontsize{10.5pt}{0truept}\selectfont
\begin{center}
\setcounter{footnote}{1}
{%
\advance\author@count\@ne
\count@\tw@
\@whilenum{\count@<\author@count}\do{%
  \edef\xx@tl{\noexpand\begin{tabular}{c}\noexpand}%
  \xx@mktbl@app{\noexpand\vspace{5pt}\csname authorName\the\count@\endcsname\noexpand\\}%
  \xx@mktbl@app{\noexpand\vspace{5pt}\csname authorAffiliate\the\count@\endcsname\noexpand\\}%
  \xx@mktbl@app{\noexpand\end{tabular}}\xx@tl
  \advance\count@\@ne
}%
}%
\end{center}
}%
\end{center}
\vskip2\Cvs
}
\def\xx@mktbl@app#1{\edef\xx@tmp{#1}\toks\tw@\expandafter{\xx@tmp}%
  \toks@\expandafter{\xx@tl}\edef\xx@tl{\the\toks@\the\toks\tw@}}